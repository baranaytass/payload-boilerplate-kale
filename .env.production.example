# ─── App ──────────────────────────────────────────────────────────────────────
APP_URL=https://your-domain.com
NODE_ENV=production

# ─── PayloadCMS ───────────────────────────────────────────────────────────────
PAYLOAD_SECRET=change-this-to-a-long-random-string-min-32-chars
PAYLOAD_PUBLIC_SERVER_URL=https://your-domain.com
NEXT_PUBLIC_SERVER_URL=https://your-domain.com

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=kale_prod
POSTGRES_USER=kale_user
POSTGRES_PASSWORD=change-this-strong-password

# ─── MinIO (media storage — S3-compatible) ────────────────────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change-this-strong-minio-password
MINIO_CONSOLE_URL=https://storage.your-domain.com
S3_BUCKET=media
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=change-this-strong-minio-password

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
GRAFANA_URL=https://monitor.your-domain.com

# ─── Umami analytics ──────────────────────────────────────────────────────────
UMAMI_APP_SECRET=change-this-umami-secret

# ─── GitHub Actions (set as repository secrets, not here) ────────────────────
# VPS_HOST      — your Contabo VPS IP address
# VPS_USER      — SSH username (e.g. root or deploy)
# VPS_SSH_KEY   — private SSH key (PEM format)
# VPS_PORT      — SSH port (default 22)
# VPS_DEPLOY_PATH — e.g. /opt/kale

# ─── Docker image ─────────────────────────────────────────────────────────────
IMAGE_TAG=latest
# GITHUB_REPOSITORY is auto-set by docker-compose from env
