# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Point this at a database dedicated to this project. In development Payload
# pushes schema changes on boot and prompts before dropping tables; if this
# points at another project's database that prompt blocks startup and /admin
# stops responding. Schema push is disabled in production - use migrations.
# For E2E runs, use a scratch database (see "Testing" in README.md).
DATABASE_URI=postgresql://username:password@localhost:5432/your_database_name
POSTGRES_URL=postgresql://username:password@localhost:5432/your_database_name

# ---------------------------------------------------------------------------
# Payload
# ---------------------------------------------------------------------------
# Signs every admin session and password-reset token. Required - the app refuses
# to boot without it, and demands at least 32 characters in production.
# Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cache revalidation
# ---------------------------------------------------------------------------
# Authenticates POST /api/revalidate, which purges the Next.js cache after a
# content change. Keep it distinct from PAYLOAD_SECRET so a leak here cannot be
# used to mint admin sessions. Leave it unset to disable revalidation entirely;
# the endpoint then refuses every request rather than purging for anyone.
# Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Media storage (optional - local disk is used when neither is configured)
# ---------------------------------------------------------------------------
# Vercel deployments: Blob storage
# BLOB_READ_WRITE_TOKEN=

# Self-hosted / VPS: any S3-compatible store (MinIO, R2, Spaces)
# S3_ENDPOINT=
# S3_BUCKET=media
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
NODE_ENV=development
